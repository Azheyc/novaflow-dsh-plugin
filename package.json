{
  "name": "@local/novaflow-dsh-plugin",
  "version": "2.4.0",
  "description": "NovaFlow account, native models and built-in image/video MCP for DeepSeek Harness",
  "repository": { "type": "git", "url": "https://github.com/Azheyc/novaflow-dsh-plugin.git" },
  "homepage": "https://github.com/Azheyc/novaflow-dsh-plugin#readme",
  "bugs": { "url": "https://github.com/Azheyc/novaflow-dsh-plugin/issues" },
  "engines": { "node": ">=24", "dsh": "0.2.2-rc.2" },
  "scripts": { "test": "node --test test/*.test.js", "check": "node --check index.js && node --check client.js" },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "VERIFICATION.md",
    "test",
    "build.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "novaflow",
    "account",
    "provider"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
